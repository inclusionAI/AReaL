# Copy outside Git, chmod 600, and fill from your existing working site profile.
# Paths must be visible at the same location in every role's container.
QWEN_REPO=
QWEN_RUN_DIR=
QWEN_OUTPUT_ROOT=
QWEN_MODEL=
QWEN_EXPERIMENT_NAME=chucai-qwen38-graybox19-rl
# Use a new trial for a new experiment; retain the same trial when recovering.
QWEN_ARENA_TRIAL=
QWEN_PARTITION=
QWEN_RESERVATION=
QWEN_NODELIST=
QWEN_CONTROLLER_NODE=
QWEN_MOUNTS=
# Include host Slurm configuration/client binaries and Munge socket/libraries.
QWEN_CONTROLLER_MOUNTS=
# Verified actor image filename: areal-dev-sglang-0821.sif.
QWEN_ACTOR_IMAGE=
# Verified inference image filename: deepep-base-85b53914.sif.
QWEN_ROLLOUT_IMAGE=
# Historical runtime containing dependencies/ and aweagent/.
# Megatron-Core 0.18.2, megatron-bridge 0.5.1.
QWEN_DENSE_RUNTIME=
# Installed AWEX 0.8.2 root containing awex/models/qwen3_5.py.
AWEX_RUNTIME_ROOT=
# Actor image site-packages plus the matching AEnv Python 3.12 package root.
QWEN_ACTOR_EXTRA_PYTHONPATH=
# Existing rollout dependency and proxy-deps roots; SGLang remains in the SIF.
QWEN_ROLLOUT_RUNTIME_DEPS=
QWEN_PROXY_DEPS=
QWEN_INFER_EXTRA_PYTHONPATH=
MEGATRON_ROOT=
# Fill the URLs and tokens for the same Arena deployment.
ARENA_OPENAPI_BASE=
ARENA_OPENAPI_TOKEN=
ARENA_LLM_API_KEY=
PRM_JUDGE_API_KEY=
WANDB_BASE_URL=
WANDB_API_KEY=
